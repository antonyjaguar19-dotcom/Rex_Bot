# ============================================================
#  Claw Bot Agent — .gitignore
# ============================================================

# --- SECRETS (never commit) -------------------------------
.env
.env.*
secrets.env
*.pem
*.key
discord_token.txt
youtube_credentials.json
oauth_token.json

# --- Python venv & cache ----------------------------------
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Models (huge, downloaded separately) -----------------
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf

# --- Generated content / logs ------------------------------
*.log
output/
temp/
input/

# --- App runtime state (per-machine, not source) -----------
.nicegui/
.qwen-history.json

# --- Archives / manual backups ------------------------------
*.zip

# --- IDE & OS noise ---------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Build artifacts --------------------------------------
build/
dist/
*.spec

# --- Claude Code session caches -----------------------------
.claude/cache/
.claude/sessions/
*_tmp_sig.txt

# Minted Kokoro voice references (regenerable cache)
05_Config/voice_refs/

# FFmpeg shared libs for torchcodec (binary, ~100MB; download via BtbN)
00_Tools/ffmpeg_shared/

# rendered outputs (large, regenerated) + caveman backup
04_Outputs/
CLAUDE.original.md
config_snapshot/*.bak

# Voice-clone reference: a real recording of the owner's voice. The repo is
# public — a person's voice sample does not belong in it. Keep it local.
# Same for every mascot on the shelf: each may carry its own cloned voice.
assets/mascot_voice.wav
assets/mascots/*/voice.*
